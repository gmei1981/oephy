    Vcb0 (codeb0 0) vsource dc=__CB0__
    Vpi (pi_in 0) vsource dc=__PCV__
    EazB (b_az_g 0 b_az 0) vcvs gain=__AZEN__
    EazA (a_az_g 0 a_az 0) vcvs gain=__AZEN__
    Idr (0 gp_a) isource dc=__DRIFT__
    MtgBn (cmp_b_n b_eval act_n vss) nch_svt_mac l=16n nfin=4
    MtgBp (cmp_b_p b_eval act_p vss) nch_svt_mac l=16n nfin=4
    MtgAn (cmp_a_n a_eval act_n vss) nch_svt_mac l=16n nfin=4
    MtgAp (cmp_a_p a_eval act_p vss) nch_svt_mac l=16n nfin=4
    MpgBn (cmp_b_n a_eval act_n vdd) pch_svt_mac l=16n nfin=4
    MpgBp (cmp_b_p a_eval act_p vdd) pch_svt_mac l=16n nfin=4
    MpgAn (cmp_a_n b_eval act_n vdd) pch_svt_mac l=16n nfin=4
    MpgAp (cmp_a_p b_eval act_p vdd) pch_svt_mac l=16n nfin=4
ends afe_tb_tran
