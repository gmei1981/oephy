subckt afe_tb_tran bit_cnt ck8 codeb0 codeb1 codeb2 codeb3 codeb4 codeb5  codeb6 codeb7 d_even d_odd err_cnt lock pclk rx_in tx_pad vccio  vdd vref vss
    G2 (aggr vdd) afe_prbs23_gen fbit=16e9 seed=19
    G1 (din vdd) afe_prbs23_gen fbit=16e9 seed=3
    CK (ck8 pclk pi_in vdd) afe_clk_gen tpclk_ph=17.5p
    PP (pclk a_eval a_az b_eval b_az vdd) afe_pingpong
    SMP (act_p act_n ck8 d_even d_odd vdd) afe_samp
    CHK (d_even d_odd ck8 lock err_cnt bit_cnt vdd) afe_ber_chk n_shift=__NS__ start_bit=200
    DRV (din tx_pad vccio vdd vss) afe_tx_drv
    BIAS (vbias vdd vss) afe_bias
    BB (b_az_g b_eval gp_b cmp_b_n cmp_b_p vbias vdd rx_in vref vss)  afecmp_bank
    BA (a_az_g a_eval gp_a cmp_a_n cmp_a_p vbias vdd rx_in vref vss)  afecmp_bank
    Rser (tx_pad ntx) resistor r=1.5
    TL (ntx vss rx_in vss) tline z0=30 td=9p
    Crx (rx_in vss) capacitor c=50f
    Cxt (aggr rx_in) capacitor c=8f
    Vcb7 (codeb7 0) vsource dc=__CB7__
    Vcb6 (codeb6 0) vsource dc=__CB6__
    Vcb5 (codeb5 0) vsource dc=__CB5__
    Vcb4 (codeb4 0) vsource dc=__CB4__
